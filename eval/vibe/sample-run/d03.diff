@@ -0,0 +1,110 @@
+//! Shooting: pressing B fires a Bullet the way the Player faces, but only
+//! while the Player has ammo, and each shot uses one (`GameData::ammo`,
+//! starting at [`STARTING_AMMO`]). With no ammo, B does nothing.
+
+use bevy::prelude::*;
+
+use super::audio::SfxEvent;
+use super::scoring::GameData;
+use super::things::{BULLET_SPEED, Bullet, Facing, Player, Size, Spawner, props};
+
+/// Ammo the Player starts each run with.
+pub const STARTING_AMMO: u32 = 5;
+
+/// Half the screen's width and height, in game pixels: a Bullet past these
+/// has left the screen.
+const HALF_SCREEN: Vec2 = Vec2::new(480.0, 360.0);
+
+/// Fires a Bullet on a B press if there is ammo left, using one.
+pub fn shoot(
+    input: Res<gamebient_input::TickInput>,
+    mut data: ResMut<GameData>,
+    player: Query<(&Transform, &Size, &Facing), With<Player>>,
+    mut spawner: Spawner,
+    mut sfx: MessageWriter<SfxEvent>,
+) {
+    if !input.secondary_just_pressed {
+        return;
+    }
+    let Ok((tf, size, facing)) = player.single() else {
+        return;
+    };
+    if !data.use_ammo() {
+        return;
+    }
+    let bullet_w = props("Bullet").map_or(0.0, |p| p.size.x);
+    let at = tf.translation.truncate() + Vec2::X * facing.0 * (size.0.x + bullet_w) * 0.5;
+    spawner.spawn_moving("Bullet", at, Vec2::X * facing.0 * BULLET_SPEED);
+    sfx.write(SfxEvent::Shoot);
+}
+
+/// Removes Bullets once they have flown off the screen.
+pub fn remove_offscreen_bullets(
+    mut commands: Commands,
+    bullets: Query<(Entity, &Transform, &Size), With<Bullet>>,
+) {
+    for (e, tf, size) in &bullets {
+        let p = tf.translation.truncate().abs() - size.0 * 0.5;
+        if p.x > HALF_SCREEN.x || p.y > HALF_SCREEN.y {
+            commands.entity(e).despawn();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::game::scenario::{Buttons, Scenario};
+
+    #[test]
+    fn b_fires_a_bullet_and_uses_one_ammo() {
+        let mut s = Scenario::new();
+        s.start();
+        assert_eq!(s.ammo(), STARTING_AMMO);
+        s.press(Buttons::B).tick(1);
+        assert_eq!(s.count("Bullet"), 1);
+        assert_eq!(s.ammo(), STARTING_AMMO - 1);
+        assert!(s.velocity("Bullet").unwrap().x > 0.0);
+        assert!(s.sounds().iter().any(|(_, e)| *e == SfxEvent::Shoot));
+    }
+
+    #[test]
+    fn no_ammo_no_shot() {
+        let mut s = Scenario::new();
+        s.set_ammo(0).press(Buttons::B).tick(1);
+        assert_eq!(s.count("Bullet"), 0);
+        assert_eq!(s.ammo(), 0);
+        assert!(!s.sounds().iter().any(|(_, e)| *e == SfxEvent::Shoot));
+    }
+
+    #[test]
+    fn ammo_runs_out() {
+        let mut s = Scenario::new();
+        s.start();
+        for _ in 0..STARTING_AMMO + 3 {
+            s.press(Buttons::B).tick(1);
+        }
+        assert_eq!(s.ammo(), 0);
+        assert_eq!(s.count("Bullet"), STARTING_AMMO as usize);
+    }
+
+    #[test]
+    fn bullets_go_the_way_the_player_faces_and_leave_the_screen() {
+        let mut s = Scenario::new();
+        s.hold(Buttons::LEFT, 1).press(Buttons::B).tick(1);
+        assert!(s.velocity("Bullet").unwrap().x < 0.0);
+        s.tick(120);
+        assert_eq!(s.count("Bullet"), 0);
+    }
+
+    #[test]
+    fn use_ammo_stops_at_zero() {
+        let mut d = GameData {
+            ammo: 1,
+            ..GameData::default()
+        };
+        assert!(d.use_ammo());
+        assert!(!d.use_ammo());
+        assert_eq!(d.ammo, 0);
+    }
+}
