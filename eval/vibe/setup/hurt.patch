@@ -0,0 +1,32 @@
+//! Hurt rule: when an Enemy starts touching the Player, the Player loses a
+//! life (once per touch, not once per tick of contact).
+
+use bevy::prelude::*;
+
+use super::scoring::GameData;
+use super::things::{Enemy, Player, Size, overlaps};
+
+/// On an Enemy that was touching the Player last tick.
+#[derive(Component)]
+pub struct TouchingPlayer;
+
+pub fn hurt_player(
+    mut commands: Commands,
+    mut data: ResMut<GameData>,
+    player: Query<(&Transform, &Size), With<Player>>,
+    enemies: Query<(Entity, &Transform, &Size, Has<TouchingPlayer>), With<Enemy>>,
+) {
+    let Ok((p_tf, p_size)) = player.single() else {
+        return;
+    };
+    let p = p_tf.translation.truncate();
+    for (e, tf, size, was_touching) in &enemies {
+        let touching = overlaps(p, p_size.0, tf.translation.truncate(), size.0);
+        if touching && !was_touching {
+            data.lives = data.lives.saturating_sub(1);
+            commands.entity(e).insert(TouchingPlayer);
+        } else if !touching && was_touching {
+            commands.entity(e).remove::<TouchingPlayer>();
+        }
+    }
+}
