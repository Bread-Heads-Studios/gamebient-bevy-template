+//! Coin rule: when the Player touches a Coin, the Coin disappears and the
+//! player scores 10 points.
+
+use bevy::prelude::*;
+
+use super::scoring::GameData;
+use super::sim::SpawnOrder;
+use super::things::{Coin, Player, Size, overlaps};
+
+pub fn collect_coins(
+    mut commands: Commands,
+    mut data: ResMut<GameData>,
+    player: Query<(&Transform, &Size), With<Player>>,
+    coins: Query<(Entity, &SpawnOrder, &Transform, &Size), With<Coin>>,
+) {
+    let Ok((p_tf, p_size)) = player.single() else {
+        return;
+    };
+    let p = p_tf.translation.truncate();
+    let mut touched: Vec<_> = coins
+        .iter()
+        .filter(|(_, _, tf, size)| overlaps(p, p_size.0, tf.translation.truncate(), size.0))
+        .collect();
+    touched.sort_unstable_by_key(|(_, order, _, _)| **order);
+    for (e, ..) in touched {
+        commands.entity(e).despawn();
+        data.add_score(10);
+    }
+}
