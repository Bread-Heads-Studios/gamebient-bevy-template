{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GX_MUTE": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sim-changed.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
