{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Level",
  "description": "Where things are placed in the game. At most 2000 things, 256 KB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "things"],
  "properties": {
    "v": { "const": 1 },
    "things": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
          "kind": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$" },
          "at": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "size": {
            "type": "array",
            "items": { "type": "number", "exclusiveMinimum": 0 },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
