{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "Rules",
  "description": "content/rules.json: rules as data. The game also checks names, unique ids, the size, self/other and timers (src/game/rules/model.rs).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "rules"],
  "properties": {
    "v": { "const": 1 },
    "rules": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
    "name": { "type": "string", "minLength": 1 },
    "int": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
    "op": { "enum": ["<", "<=", "=", ">=", ">"] },
    "ticks": { "type": "integer", "minimum": 1, "maximum": 36000 },
    "comparison": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/op" }, { "$ref": "#/$defs/int" }],
      "minItems": 3,
      "maxItems": 3
    },
    "place": {
      "anyOf": [
        { "enum": ["start", "random", "self"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
            "y": { "type": "number", "minimum": -100000, "maximum": 100000 }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "do"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "when": { "$ref": "#/$defs/trigger" },
        "if": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/condition" } },
        "do": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/action" } },
        "source": { "type": "string", "maxLength": 200 },
        "off": { "type": "boolean" }
      }
    },
    "trigger": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["start"], "properties": { "start": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["every"], "properties": { "every": { "$ref": "#/$defs/ticks" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["button"],
          "properties": { "button": { "type": "array", "prefixItems": [{ "enum": ["A", "B"] }, { "enum": ["pressed", "held"] }], "minItems": 2, "maxItems": 2 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["touch"],
          "properties": { "touch": { "type": "array", "items": { "$ref": "#/$defs/name" }, "minItems": 2, "maxItems": 2 } }
        },
        { "type": "object", "additionalProperties": false, "required": ["counter"], "properties": { "counter": { "$ref": "#/$defs/comparison" } } },
        { "type": "object", "additionalProperties": false, "required": ["timer"], "properties": { "timer": { "$ref": "#/$defs/id" } } }
      ]
    },
    "condition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["compare"], "properties": { "compare": { "$ref": "#/$defs/comparison" } } },
        { "type": "object", "additionalProperties": false, "required": ["chance"], "properties": { "chance": { "type": "integer", "minimum": 1, "maximum": 100 } } }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["add"],
          "properties": { "add": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/int" }], "minItems": 2, "maxItems": 2 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["set"],
          "properties": { "set": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/int" }], "minItems": 2, "maxItems": 2 } }
        },
        { "type": "object", "additionalProperties": false, "required": ["remove"], "properties": { "remove": { "$ref": "#/$defs/name" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["spawn"],
          "properties": { "spawn": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/place" }], "minItems": 2, "maxItems": 2 } }
        },
        { "type": "object", "additionalProperties": false, "required": ["respawn"], "properties": { "respawn": { "$ref": "#/$defs/name" } } },
        { "type": "object", "additionalProperties": false, "required": ["jump"], "properties": { "jump": { "$ref": "#/$defs/name" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["move"],
          "properties": {
            "move": {
              "type": "array",
              "prefixItems": [
                { "$ref": "#/$defs/name" },
                { "type": "number", "minimum": -1000, "maximum": 1000 },
                { "type": "number", "minimum": -1000, "maximum": 1000 }
              ],
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["sound"], "properties": { "sound": { "$ref": "#/$defs/name" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["timer"],
          "properties": { "timer": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/id" }, { "$ref": "#/$defs/ticks" }], "minItems": 2, "maxItems": 2 } }
        },
        { "type": "object", "additionalProperties": false, "required": ["end_run"], "properties": { "end_run": { "enum": ["win", "lose"] } } }
      ]
    }
  }
}
