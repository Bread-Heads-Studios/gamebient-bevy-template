{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Songs",
  "description": "Chip music, one entry per cue. 128 KB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "songs"],
  "properties": {
    "v": { "const": 1 },
    "songs": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bpm", "beats_per_bar", "steps_per_beat", "bars", "voices", "instruments"],
        "properties": {
          "bpm": { "type": "number", "minimum": 30, "maximum": 300 },
          "beats_per_bar": { "type": "integer", "minimum": 1, "maximum": 16 },
          "steps_per_beat": { "type": "integer", "minimum": 1, "maximum": 16 },
          "bars": { "type": "integer", "minimum": 1, "maximum": 64 },
          "voices": {
            "type": "array",
            "items": { "type": "string", "maxLength": 16384 },
            "minItems": 3,
            "maxItems": 3
          },
          "noise": { "type": "string", "maxLength": 16384 },
          "instruments": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/instrument" } },
          "noise_instruments": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/instrument" } }
        }
      }
    }
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env"],
      "properties": {
        "env": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 15 },
          "minItems": 1,
          "maxItems": 64
        },
        "release": { "type": "integer", "minimum": 0, "maximum": 255 },
        "arp": {
          "type": "array",
          "items": { "type": "integer", "minimum": -128, "maximum": 127 },
          "maxItems": 16
        },
        "vibrato": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "noise": {
          "type": "array",
          "prefixItems": [
            { "enum": ["white", "periodic"] },
            { "enum": ["div512", "div1024", "div2048", "tone3"] }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
